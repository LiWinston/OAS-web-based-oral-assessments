<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.swen90017.oas.mapper.ExaminerAssignmentLimitMapper">

    <!-- Update max_sessions by (examiner_id, assignment_id); no-op if pair not exists -->
    <update id="updateMaxSessionsByPair">
        UPDATE examiner_assignment_limit
        SET max_sessions = #{maxSessions}
        WHERE examiner_id = #{examinerId}
          AND assignment_id = #{assignmentId}
    </update>

</mapper>


