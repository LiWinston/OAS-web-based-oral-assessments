  }
  
  class CanvasApiClientImpl implements CanvasApiClient {
    - apiKey: String
    - baseUrl: String
    - restTemplate: RestTemplate
    + importStudents(courseId: String): List<StudentDTO>
    + exportGrades(courseId: String, grades: List<GradeDTO>): void
    + createCourseAnnouncement(courseId: String, announcement: AnnouncementDTO): void
  }
  
  interface ZoomApiClient {
    + createMeeting(meetingRequest: ZoomMeetingRequest): ZoomMeetingResponse
    + getMeeting(meetingId: String): ZoomMeetingResponse
    + deleteMeeting(meetingId: String): void
    + generateJoinUrl(meetingId: String, userName: String): String
  }
  
  class ZoomApiClientImpl implements ZoomApiClient {
    - apiKey: String
    - apiSecret: String
    - baseUrl: String
    - restTemplate: RestTemplate
    + createMeeting(meetingRequest: ZoomMeetingRequest): ZoomMeetingResponse
    + getMeeting(meetingId: String): ZoomMeetingResponse
    + deleteMeeting(meetingId: String): void
    + generateJoinUrl(meetingId: String, userName: String): String
  }
  
  class ZoomMeetingRequest {
    - topic: String
