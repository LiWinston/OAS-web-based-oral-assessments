{
  "info": {
    "name": "Student Booking API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "student-booking-tests-001"
  },
  "item": [
    {
      "name": "1. List student assignments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/{studentId}/assignments?status=all&pageNum=0&pageSize=10&sort=date_asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{studentId}",
            "assignments?status=all&pageNum=0&pageSize=10&sort=date_asc"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code should be 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response should contain assignmentId\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data.data[0]).to.have.property(\"assignmentId\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Get assignment availability",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/availability?studentId={studentId}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "availability?studentId={studentId}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code should be 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Should contain summary field\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"summary\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. List bookable sessions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/sessions?studentId={studentId}&date=2025-04-14&includeReasons=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "sessions?studentId={studentId}&date=2025-04-14&includeReasons=true"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response should contain timeSlots\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"timeSlots\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Create booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"groupId\": \"{{groupId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response should contain bookingId\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"bookingId\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Get current booking",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/{studentId}/assignments/{assignmentId}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{studentId}",
            "assignments",
            "{assignmentId}",
            "booking"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Should return hasActiveBooking\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"hasActiveBooking\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Reschedule booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/bookings/{bookingId}/reschedule",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "bookings",
            "{bookingId}",
            "reschedule"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"targetSessionId\": \"{{targetSessionId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response should contain fromSessionId and toSessionId\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"fromSessionId\");",
              "  pm.expect(json.data).to.have.property(\"toSessionId\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Cancel booking",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/bookings/{bookingId}?studentId={studentId}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "bookings",
            "{bookingId}?studentId={studentId}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Should return CANCELLED status\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data.status).to.eql(\"CANCELLED\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. Get group info",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/{studentId}/assignments/{assignmentId}/group",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{studentId}",
            "assignments",
            "{assignmentId}",
            "group"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Should return groupId and members\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"groupId\");",
              "  pm.expect(json.data).to.have.property(\"members\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}