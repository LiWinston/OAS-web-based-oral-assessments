{
  "info": {
    "name": "Student Booking API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "student-booking-tests-001"
  },
  "item": [
    {
      "name": "1. 列出学生作业",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/{studentId}/assignments?status=all&pageNum=0&pageSize=10&sort=date_asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{studentId}",
            "assignments?status=all&pageNum=0&pageSize=10&sort=date_asc"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"状态码应为 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"返回应包含 assignmentId\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data.data[0]).to.have.property(\"assignmentId\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. 获取作业可用性",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/availability?studentId={studentId}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "availability?studentId={studentId}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"状态码应为 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"应包含 summary 字段\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"summary\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. 列出可预约场次",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/sessions?studentId={studentId}&date=2025-04-14&includeReasons=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "sessions?studentId={studentId}&date=2025-04-14&includeReasons=true"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"返回应包含 timeSlots\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"timeSlots\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. 创建预约",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"groupId\": \"{{groupId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"返回应包含 bookingId\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"bookingId\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. 获取当前预约",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/{studentId}/assignments/{assignmentId}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{studentId}",
            "assignments",
            "{assignmentId}",
            "booking"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"应返回 hasActiveBooking\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"hasActiveBooking\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. 改签预约",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/bookings/{bookingId}/reschedule",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "bookings",
            "{bookingId}",
            "reschedule"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"targetSessionId\": \"{{targetSessionId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"返回应包含 fromSessionId 和 toSessionId\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"fromSessionId\");",
              "  pm.expect(json.data).to.have.property(\"toSessionId\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. 取消预约",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assignments/{assignmentId}/bookings/{bookingId}?studentId={studentId}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments",
            "{assignmentId}",
            "bookings",
            "{bookingId}?studentId={studentId}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"应返回 CANCELLED 状态\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data.status).to.eql(\"CANCELLED\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. 获取小组信息",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/{studentId}/assignments/{assignmentId}/group",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{studentId}",
            "assignments",
            "{assignmentId}",
            "group"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"应返回 groupId 和 members\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"groupId\");",
              "  pm.expect(json.data).to.have.property(\"members\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}