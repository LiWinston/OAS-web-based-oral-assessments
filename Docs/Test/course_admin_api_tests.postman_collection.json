{
  "info": {
    "name": "Course Admin Timeslots & Schedule API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "course-admin-tests-001"
  },
  "item": [
    {
      "name": "1. 获取作业会话配置",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/assignments/{assignmentId}/session-config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "assignments",
            "{assignmentId}",
            "session-config"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"状态码应为 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"应包含 sessionLength\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"sessionLength\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. 更新作业会话配置",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/assignments/{assignmentId}/session-config",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "assignments",
            "{assignmentId}",
            "session-config"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionLength\": 30,\n  \"gapTime\": 5,\n  \"examinersPerSession\": 2\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"状态码应为 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"应返回更新后的参数\", () => {",
              "  let json = pm.response.json();",
              "  pm.expect(json.data).to.have.property(\"sessionLength\", 30);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
